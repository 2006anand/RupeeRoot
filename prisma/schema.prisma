generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  UPI
  DEBIT_CARD
  CREDIT_CARD
  NET_BANKING
  WALLET
  OTHER
}

enum RecurrenceInterval {
  WEEKLY
  MONTHLY
  YEARLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum NotificationType {
  BUDGET_WARNING
  BUDGET_HIGH
  BUDGET_EXCEEDED
  SPENDING_INSIGHT
  FORECAST_WARNING
  GOAL_MILESTONE
  RECURRING_GENERATED
}

enum InsightType {
  SPENDING_INCREASE
  SPENDING_DECREASE
  HIGHEST_CATEGORY
  BUDGET_NEARING
  BUDGET_EXCEEDED
  UNUSUAL_SPENDING
  OVERSPENDING_RISK
  SAVINGS_OPPORTUNITY
}

enum InsightSeverity {
  INFO
  WARNING
  CRITICAL
  POSITIVE
}

model User {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String   @db.VarChar(100)
  email               String   @unique @db.VarChar(255)
  passwordHash        String   @db.VarChar(255)
  currency            String   @default("INR") @db.VarChar(10)
  timezone            String   @default("Asia/Kolkata") @db.VarChar(64)
  warningThreshold    Int      @default(75)
  highThreshold       Int      @default(90)
  exceededThreshold   Int      @default(100)
  monthlyIncomeTarget Decimal? @db.Decimal(12, 2)
  resetToken          String?  @db.VarChar(255)
  resetTokenExpiry    DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  categories            Category[]
  transactions          Transaction[]
  budgets               Budget[]
  savingsGoals          SavingsGoal[]
  savingsContributions  SavingsContribution[]
  recurringTransactions RecurringTransaction[]
  notifications         Notification[]
  insights              Insight[]
}

model Category {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @db.VarChar(60)
  type      TransactionType
  icon      String          @default("Tag") @db.VarChar(40)
  color     String          @default("#3B82F6") @db.VarChar(20)
  isSystem  Boolean         @default(false)
  userId    String?         @db.Uuid
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user                  User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  insights              Insight[]

  @@unique([userId, name, type])
  @@index([userId, type])
  @@index([isSystem])
}

model Transaction {
  id                      String        @id @default(uuid()) @db.Uuid
  userId                  String        @db.Uuid
  categoryId              String        @db.Uuid
  title                   String        @db.VarChar(160)
  amount                  Decimal       @db.Decimal(12, 2)
  type                    TransactionType
  date                    DateTime
  paymentMethod           PaymentMethod @default(UPI)
  notes                   String?       @db.VarChar(500)
  recurringId             String?       @db.Uuid
  recurringOccurrenceDate DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recurring RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@unique([recurringId, recurringOccurrenceDate])
  @@index([userId, date(sort: Desc)])
  @@index([userId, type, date(sort: Desc)])
  @@index([userId, categoryId])
}

model Budget {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  categoryId  String?  @db.Uuid
  budgetKey   String   @db.VarChar(64)
  month       Int
  year        Int
  limitAmount Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, budgetKey, month, year])
  @@index([userId, year, month])
}

model SavingsGoal {
  id            String     @id @default(uuid()) @db.Uuid
  userId        String     @db.Uuid
  title         String     @db.VarChar(120)
  targetAmount  Decimal    @db.Decimal(12, 2)
  currentAmount Decimal    @default(0) @db.Decimal(12, 2)
  targetDate    DateTime?
  description   String?    @db.VarChar(400)
  status        GoalStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions SavingsContribution[]

  @@index([userId, status])
}

model SavingsContribution {
  id            String   @id @default(uuid()) @db.Uuid
  goalId        String   @db.Uuid
  userId        String   @db.Uuid
  amount        Decimal  @db.Decimal(12, 2)
  note          String?  @db.VarChar(250)
  contributedAt DateTime @default(now())
  createdAt     DateTime @default(now())

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, contributedAt(sort: Desc)])
  @@index([userId])
}

model RecurringTransaction {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @db.Uuid
  categoryId      String             @db.Uuid
  title           String             @db.VarChar(160)
  amount          Decimal            @db.Decimal(12, 2)
  type            TransactionType
  paymentMethod   PaymentMethod      @default(UPI)
  notes           String?            @db.VarChar(500)
  interval        RecurrenceInterval
  startDate       DateTime
  endDate         DateTime?
  nextOccurrence  DateTime
  lastGeneratedAt DateTime?
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([userId, isActive, nextOccurrence])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(160)
  message   String           @db.VarChar(500)
  dedupeKey String?          @db.VarChar(160)
  relatedId String?          @db.VarChar(64)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, isRead, createdAt(sort: Desc)])
}

model Insight {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  type        InsightType
  title       String          @db.VarChar(160)
  description String          @db.VarChar(500)
  severity    InsightSeverity
  categoryId  String?         @db.Uuid
  periodKey   String          @db.VarChar(32)
  dedupeKey   String          @db.VarChar(160)
  isRead      Boolean         @default(false)
  generatedAt DateTime        @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@index([userId, generatedAt(sort: Desc)])
}
