# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spendwise?schema=public"

# Secret for signing JWT session cookies (use at least 32 random chars in production)
AUTH_SECRET="replace-with-a-secure-32-character-random-secret"

# Public application URL
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional secret to authorize external cron hits to /api/recurring/process
CRON_SECRET="replace-with-cron-secret"
